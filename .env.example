# Aggregated env for the repository-root docker-compose.yaml.
#
# Each service also has its own .env.example under <service>/.env.example.
# When running a service standalone (cd <service> && just up), use that one.
# When running the whole stack (just up at the repo root), use this one.

# ─── user_service ────────────────────────────────────────────────────────────
USER_SERVICE_SERVER_PORT=8080
USER_SERVICE_MULTIPART_MAX_FILE_SIZE=10MB
USER_SERVICE_MULTIPART_MAX_REQUEST_SIZE=10MB
USER_SERVICE_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

USER_SERVICE_POSTGRES_HOST=user-service-postgres
USER_SERVICE_POSTGRES_PORT=5432
USER_SERVICE_POSTGRES_EXTERNAL_PORT=5435
USER_SERVICE_POSTGRES_DB=user_service
USER_SERVICE_POSTGRES_USER=morrs
USER_SERVICE_POSTGRES_PASSWORD=123

USER_SERVICE_S3_ENABLED=true
USER_SERVICE_S3_BUCKET=user-service-local
USER_SERVICE_S3_REGION=us-east-1
USER_SERVICE_S3_ACCESS_KEY=seaweedfs-admin
USER_SERVICE_S3_SECRET_KEY=seaweedfs-admin-secret
USER_SERVICE_S3_ENDPOINT=http://user-service-seaweedfs:8333
USER_SERVICE_S3_PATH_STYLE_ACCESS=true
USER_SERVICE_S3_PUBLIC_BASE_URL=http://localhost:8333/user-service-local
USER_SERVICE_S3_ADMIN_PORT=9333
USER_SERVICE_S3_FILER_PORT=8888
USER_SERVICE_S3_API_PORT=8333

USER_SERVICE_LIQUIBASE_CHANGELOG=db.changelog-master.yaml

# ─── learning_service ────────────────────────────────────────────────────────
LEARNING_SERVICE_SERVER_PORT=8082
LEARNING_SERVICE_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

LEARNING_SERVICE_POSTGRES_HOST=learning-service-postgres
LEARNING_SERVICE_POSTGRES_PORT=5432
LEARNING_SERVICE_POSTGRES_EXTERNAL_PORT=5437
LEARNING_SERVICE_POSTGRES_DB=learning_service_db
LEARNING_SERVICE_POSTGRES_USER=morrs
LEARNING_SERVICE_POSTGRES_PASSWORD=123

LEARNING_SERVICE_LIQUIBASE_CHANGELOG=db.changelog-master.yaml

# ─── api_gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_SERVER_PORT=8090
API_GATEWAY_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0
API_GATEWAY_ENTRY_PATH_PREFIX=/api

API_GATEWAY_JWT_SECRET=dev-secret-change-me-at-least-32-chars
API_GATEWAY_JWT_TTL=15m

# Match the container hostnames declared in each sub-compose.
API_GATEWAY_USER_SERVICE_URI=http://user-service-app:8080
API_GATEWAY_COURSE_SERVICE_URI=http://course-service-app:8081
API_GATEWAY_LEARNING_SERVICE_URI=http://learning-service-app:8082

# ─── answer_service ──────────────────────────────────────────────────────────
# answer_service predates the *_SERVICE_ prefix convention and uses plain env
# names. Its docker-compose.prod.yaml under answer_service/ reads them as-is.
# Keep them here so a root-level `cp .env.example .env` works for everyone.
POSTGRES_HOST=answer-service-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=answer-service
POSTGRES_PORT=5432
POSTGRES_DRIVER=asyncpg

DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=3600
DB_POOL_SIZE=50
DB_POOL_MAX_OVERFLOW=25
DB_ECHO=False
DB_AUTO_FLUSH=False
DB_EXPIRE_ON_COMMIT=False
DB_DEBUG=True
DB_FUTURE=True

RABBITMQ_HOST=answer-service-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

UVICORN_HOST=0.0.0.0
# 8085 (not 8080) — user-app already binds 8080 in this stack.
UVICORN_PORT=8085
FASTAPI_ALLOW_CREDENTIALS=False
FASTAPI_DEBUG=False

REDIS_HOST=answer-service-redis
REDIS_PASSWORD=default
REDIS_USER=automatic-responses
REDIS_USER_PASSWORD=default
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_WORKER_DB=1
REDIS_MAX_CONNECTIONS=20
REDIS_SCHEDULE_SOURCE_DB=2

CHROMA_HOST=answer-service-chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=lesson_chunks

# OpenAI — leave blank locally if you do not have a key; the RAG path will fail
# at request time but the rest of the service still boots.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TEMPERATURE=0.0
OPENAI_EMBEDDING_CHUNK_SIZE=100

# ─── frontend ────────────────────────────────────────────────────────────────
FRONTEND_SERVER_PORT=80
FRONTEND_EXTERNAL_PORT=3000
FRONTEND_GATEWAY_HOST=api-gateway-app
FRONTEND_GATEWAY_PORT=8090

# VITE_* are inlined into the built bundle. Defaults route same-origin so
# the bundle does not encode a host name; nginx does the reverse-proxying.
VITE_API_GATEWAY_URL=/
VITE_AUTH_API_BASE_URL=/auth
VITE_USER_SERVICE_API_BASE_URL=/api/user
VITE_USER_SERVICE_DEMO_USER_ID=909262ef-d229-47aa-8fdd-8c3f93adfd5d
VITE_LEARNING_SERVICE_API_BASE_URL=/api/learning
VITE_COURSE_SERVICE_API_BASE_URL=/api/course
