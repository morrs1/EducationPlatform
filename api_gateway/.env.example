# Copy to `.env` and adjust for your environment.

# ─── Application ─────────────────────────────────────────────────────────────
API_GATEWAY_SERVER_PORT=8090
API_GATEWAY_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0
API_GATEWAY_ENTRY_PATH_PREFIX=/api

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# JWT_SECRET MUST be overridden in prod. The default is dev-only and rejected
# by any sensible reviewer.
API_GATEWAY_JWT_SECRET=dev-secret-change-me-at-least-32-chars
API_GATEWAY_JWT_TTL=15m

# ─── Downstream services ─────────────────────────────────────────────────────
# Hostnames match the per-service compose containers (see each service's
# docker-compose.yaml). When running the gateway outside docker, point at
# localhost:<external-port> instead.
API_GATEWAY_USER_SERVICE_URI=http://user-service-app:8080
API_GATEWAY_COURSE_SERVICE_URI=http://course-service-app:8081
API_GATEWAY_LEARNING_SERVICE_URI=http://learning-service-app:8082
