# Copy to `.env` and adjust for your environment.

# ─── Application ─────────────────────────────────────────────────────────────
COURSE_SERVICE_SERVER_PORT=8081
COURSE_SERVICE_MULTIPART_MAX_FILE_SIZE=200MB
COURSE_SERVICE_MULTIPART_MAX_REQUEST_SIZE=200MB
COURSE_SERVICE_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Running app outside docker? Override HOST=localhost and PORT=${EXTERNAL_PORT}.
COURSE_SERVICE_POSTGRES_HOST=course-service-postgres
COURSE_SERVICE_POSTGRES_PORT=5432
COURSE_SERVICE_POSTGRES_EXTERNAL_PORT=5436
COURSE_SERVICE_POSTGRES_DB=course_service
COURSE_SERVICE_POSTGRES_USER=morrs
COURSE_SERVICE_POSTGRES_PASSWORD=123

# ─── SeaweedFS (S3-compatible) ───────────────────────────────────────────────
# Shares the SeaweedFS instance brought up by user_service in the full stack.
# Override S3_ENDPOINT when running standalone.
COURSE_SERVICE_S3_ENABLED=true
COURSE_SERVICE_S3_BUCKET=course-service-local
COURSE_SERVICE_S3_REGION=us-east-1
COURSE_SERVICE_S3_ACCESS_KEY=seaweedfs-admin
COURSE_SERVICE_S3_SECRET_KEY=seaweedfs-admin-secret
COURSE_SERVICE_S3_ENDPOINT=http://user-service-seaweedfs:8333
COURSE_SERVICE_S3_PATH_STYLE_ACCESS=true
COURSE_SERVICE_S3_PUBLIC_BASE_URL=http://user-service-seaweedfs:8333/course-service-local

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# Shares the broker brought up by answer_service in the full stack.
COURSE_SERVICE_RABBITMQ_HOST=answer-service-rabbitmq
COURSE_SERVICE_RABBITMQ_PORT=5672
COURSE_SERVICE_RABBITMQ_USER=guest
COURSE_SERVICE_RABBITMQ_PASSWORD=guest

# ─── Liquibase ───────────────────────────────────────────────────────────────
COURSE_SERVICE_LIQUIBASE_CHANGELOG=db.changelog-master.yaml
