server {
    listen ${FRONTEND_SERVER_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS lives on 127.0.0.11. Without `resolver`, nginx
    # resolves upstream hostnames once at start-up; if the gateway container
    # is not up yet (or its IP changes after a restart), every proxy_pass
    # returns 500. The variable in proxy_pass below forces a runtime lookup
    # against this resolver instead of a one-shot resolve.
    resolver 127.0.0.11 valid=30s ipv6=off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/xml
        font/woff2
        image/svg+xml
        text/css
        text/javascript
        text/plain;

    # Profile photo upload bypasses api_gateway (multipart).
    location = /api/user/add_photo {
        client_max_body_size 12m;
        set $user_upstream "${FRONTEND_USER_SERVICE_HOST}:${FRONTEND_USER_SERVICE_PORT}";
        proxy_pass http://$user_upstream/user/add_photo$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # Public author display names use user_service directly; /api/user/** is otherwise protected by api_gateway.
    location = /api/user-service/user {
        set $user_upstream "${FRONTEND_USER_SERVICE_HOST}:${FRONTEND_USER_SERVICE_PORT}";
        proxy_pass http://$user_upstream/user$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }

    # Profile photos are stored in SeaweedFS/S3, but the app uses same-origin
    # URLs so the browser never needs Docker DNS names or S3 credentials.
    location ^~ /api/user-service-media/ {
        set $user_s3_upstream "${FRONTEND_USER_SERVICE_S3_HOST}:${FRONTEND_USER_SERVICE_S3_FILER_PORT}";
        rewrite ^/api/user-service-media/(.*)$ /buckets/$1 break;
        proxy_pass http://$user_s3_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Course lesson assets are stored in SeaweedFS/S3. Keep reads same-origin
    # and route them before static asset regex locations match .png/.mp4 paths.
    location ^~ /api/course-service-media/ {
        set $course_s3_upstream "${FRONTEND_COURSE_SERVICE_S3_HOST}:${FRONTEND_COURSE_SERVICE_S3_FILER_PORT}";
        rewrite ^/api/course-service-media/(.*)$ /buckets/${FRONTEND_COURSE_SERVICE_S3_BUCKET}/$1 break;
        proxy_pass http://$course_s3_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Lesson asset upload bypasses api_gateway (multipart).
    location ~ ^/api/course/lesson/([^/]+)/asset/?$ {
        client_max_body_size 200m;
        set $course_upstream "${FRONTEND_COURSE_SERVICE_HOST}:${FRONTEND_COURSE_SERVICE_PORT}";
        rewrite ^/api/course/(.*)$ /course/$1 break;
        proxy_pass http://$course_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # answer_service is not routed through api_gateway; browser stays same-origin.
    location ^~ /api/answer/ {
        client_max_body_size 50m;
        set $answer_upstream "${FRONTEND_ANSWER_SERVICE_HOST}:${FRONTEND_ANSWER_SERVICE_PORT}";
        rewrite ^/api/answer/(.*)$ /$1 break;
        proxy_pass http://$answer_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }

    location ~* \.(?:js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|webp|svg|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location /api/ {
        set $gateway_upstream "${FRONTEND_GATEWAY_HOST}:${FRONTEND_GATEWAY_PORT}";
        proxy_pass http://$gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 200m;
    }

    location /auth/ {
        set $gateway_upstream "${FRONTEND_GATEWAY_HOST}:${FRONTEND_GATEWAY_PORT}";
        proxy_pass http://$gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
