server {
    listen ${FRONTEND_SERVER_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS lives on 127.0.0.11. Without `resolver`, nginx
    # resolves upstream hostnames once at start-up; if the gateway container
    # is not up yet (or its IP changes after a restart), every proxy_pass
    # returns 500. The variable in proxy_pass below forces a runtime lookup
    # against this resolver instead of a one-shot resolve.
    resolver 127.0.0.11 valid=30s ipv6=off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/xml
        font/woff2
        image/svg+xml
        text/css
        text/javascript
        text/plain;

    location ~* \.(?:js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|webp|svg|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location /api/ {
        set $gateway_upstream "${FRONTEND_GATEWAY_HOST}:${FRONTEND_GATEWAY_PORT}";
        proxy_pass http://$gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        client_max_body_size 200m;
    }

    location /auth/ {
        set $gateway_upstream "${FRONTEND_GATEWAY_HOST}:${FRONTEND_GATEWAY_PORT}";
        proxy_pass http://$gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
