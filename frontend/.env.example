# Copy to `.env` (and/or `.env.development` / `.env.production`) and adjust.
# VITE_* are inlined into the bundle at build time.

# ─── Gateway + per-service API roots ─────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8090
VITE_AUTH_API_BASE_URL=/auth
VITE_USER_SERVICE_URL=http://localhost:8080
VITE_USER_SERVICE_API_BASE_URL=/api/user
VITE_USER_SERVICE_DEMO_USER_ID=909262ef-d229-47aa-8fdd-8c3f93adfd5d
VITE_LEARNING_SERVICE_URL=http://localhost:8082
VITE_LEARNING_SERVICE_API_BASE_URL=/api/learning
VITE_COURSE_SERVICE_API_BASE_URL=/api/course

# ─── Dev server: out-of-gateway targets ──────────────────────────────────────
# answer_service: Vite proxies /api/answer → localhost:8085 (strip prefix). Prod: nginx does the same.
VITE_ANSWER_SERVICE_PROXY_TARGET=http://localhost:8085
# Lesson asset upload bypasses the gateway in dev (multipart bug workaround).
VITE_COURSE_SERVICE_DIRECT_URL=http://localhost:8081
# Lesson asset GETs are proxied through Vite to SeaweedFS Filer in dev.
VITE_COURSE_SERVICE_MEDIA_PROXY_TARGET=http://localhost:8888
VITE_COURSE_SERVICE_MEDIA_BUCKET=course-service-local
# Profile photo POST bypasses gateway in dev (Vite pipes to user_service). Prod: nginx does the same.
# Set only if you want the browser to call user_service directly (needs CORS on user_service).
# VITE_USER_SERVICE_DIRECT_URL=http://localhost:8080
# Profile photo GETs are proxied through Vite to SeaweedFS Filer in dev.
VITE_USER_SERVICE_MEDIA_PROXY_TARGET=http://localhost:8888

# ─── Docker runtime (nginx) ──────────────────────────────────────────────────
FRONTEND_SERVER_PORT=80
FRONTEND_EXTERNAL_PORT=3000
FRONTEND_GATEWAY_HOST=api-gateway-app
FRONTEND_GATEWAY_PORT=8090
FRONTEND_USER_SERVICE_HOST=user-service-app
FRONTEND_USER_SERVICE_PORT=8080
FRONTEND_USER_SERVICE_S3_HOST=user-service-seaweedfs
FRONTEND_USER_SERVICE_S3_FILER_PORT=8888
FRONTEND_COURSE_SERVICE_HOST=course-service-app
FRONTEND_COURSE_SERVICE_PORT=8081
FRONTEND_COURSE_SERVICE_S3_HOST=user-service-seaweedfs
FRONTEND_COURSE_SERVICE_S3_FILER_PORT=8888
FRONTEND_COURSE_SERVICE_S3_BUCKET=course-service-local
FRONTEND_ANSWER_SERVICE_HOST=answer-service-api
FRONTEND_ANSWER_SERVICE_PORT=8085
