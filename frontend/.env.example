# Copy to `.env` (and/or `.env.development` / `.env.production`) and adjust.
# VITE_* are inlined into the bundle at build time; the rest are only used by
# the vite dev middleware in vite.config.js.

# ─── Gateway + per-service API roots ─────────────────────────────────────────
VITE_API_GATEWAY_URL=http://localhost:8090
VITE_AUTH_API_BASE_URL=/auth
VITE_USER_SERVICE_URL=http://localhost:8080
VITE_USER_SERVICE_API_BASE_URL=/api/user
VITE_USER_SERVICE_DEMO_USER_ID=909262ef-d229-47aa-8fdd-8c3f93adfd5d
VITE_LEARNING_SERVICE_URL=http://localhost:8082
VITE_LEARNING_SERVICE_API_BASE_URL=/api/learning
VITE_COURSE_SERVICE_API_BASE_URL=/api/course

# ─── Dev server: out-of-gateway targets ──────────────────────────────────────
# answer_service is not routed through the gateway yet.
VITE_ANSWER_SERVICE_PROXY_TARGET=http://localhost:8085
# Lesson asset upload bypasses the gateway in dev (multipart bug workaround).
VITE_COURSE_SERVICE_DIRECT_URL=http://localhost:8081

# ─── Dev server: S3 media proxy ──────────────────────────────────────────────
# Used only by the vite middleware; not embedded in the production bundle.
USER_SERVICE_S3_ENDPOINT=http://localhost:8333
USER_SERVICE_S3_REGION=us-east-1
USER_SERVICE_S3_ACCESS_KEY=seaweedfs-admin
USER_SERVICE_S3_SECRET_KEY=seaweedfs-admin-secret
USER_SERVICE_S3_FORCE_PATH_STYLE=true
COURSE_SERVICE_S3_BUCKET=course-service-local

# ─── Docker runtime (nginx) ──────────────────────────────────────────────────
FRONTEND_SERVER_PORT=80
FRONTEND_EXTERNAL_PORT=3000
FRONTEND_GATEWAY_HOST=api-gateway-app
FRONTEND_GATEWAY_PORT=8090
