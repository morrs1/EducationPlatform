# user_service environment variables.
#
# All variables are prefixed with USER_SERVICE_ so they namespace cleanly inside
# the monorepo (no collisions with other services when sharing a shell session
# or a docker network).
#
# Copy to `.env` and adjust for your environment:
#   cp .env.example .env

# ─── Application ─────────────────────────────────────────────────────────────
USER_SERVICE_SERVER_PORT=8080
USER_SERVICE_MULTIPART_MAX_FILE_SIZE=10MB
USER_SERVICE_MULTIPART_MAX_REQUEST_SIZE=10MB
USER_SERVICE_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# In-container hostname for the app, exposed port for the host machine.
USER_SERVICE_POSTGRES_HOST=user_service.postgres
USER_SERVICE_POSTGRES_PORT=5432
USER_SERVICE_POSTGRES_EXTERNAL_PORT=5435
USER_SERVICE_POSTGRES_DB=user_service
USER_SERVICE_POSTGRES_USER=morrs
USER_SERVICE_POSTGRES_PASSWORD=123

# ─── SeaweedFS (S3-compatible) ───────────────────────────────────────────────
# The "S3" subsystem is provisional. Property prefix stays `temp.s3.*` in
# application.yaml, but env vars are namespaced under USER_SERVICE_S3_*.
USER_SERVICE_S3_ENABLED=true
USER_SERVICE_S3_BUCKET=user-service-local
USER_SERVICE_S3_REGION=us-east-1
USER_SERVICE_S3_ACCESS_KEY=seaweedfs-admin
USER_SERVICE_S3_SECRET_KEY=seaweedfs-admin-secret
USER_SERVICE_S3_ENDPOINT=http://user_service.seaweedfs:8333
USER_SERVICE_S3_PATH_STYLE_ACCESS=true
USER_SERVICE_S3_PUBLIC_BASE_URL=http://localhost:8333/user-service-local
USER_SERVICE_S3_ADMIN_PORT=9333
USER_SERVICE_S3_FILER_PORT=8888
USER_SERVICE_S3_API_PORT=8333

# ─── Liquibase ───────────────────────────────────────────────────────────────
# JDBC URL is built by docker-compose from the Postgres vars above.
USER_SERVICE_LIQUIBASE_CHANGELOG=db.changelog-master.yaml
