# Copy to `.env` and adjust for your environment.

# ─── Application ─────────────────────────────────────────────────────────────
LEARNING_SERVICE_SERVER_PORT=8082
LEARNING_SERVICE_JVM_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Running app outside docker? Override HOST=localhost and PORT=${EXTERNAL_PORT}.
LEARNING_SERVICE_POSTGRES_HOST=learning_service.postgres
LEARNING_SERVICE_POSTGRES_PORT=5432
LEARNING_SERVICE_POSTGRES_EXTERNAL_PORT=5437
LEARNING_SERVICE_POSTGRES_DB=learning_service_db
LEARNING_SERVICE_POSTGRES_USER=morrs
LEARNING_SERVICE_POSTGRES_PASSWORD=123

# ─── Liquibase ───────────────────────────────────────────────────────────────
LEARNING_SERVICE_LIQUIBASE_CHANGELOG=db.changelog-master.yaml
